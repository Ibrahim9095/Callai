{
  "name": "ai-voice-os",
  "version": "0.2.0",
  "private": true,
  "description": "AI Voice OS — Multi-Tenant AI Voice SaaS Platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:api": "npm --workspace @aivoiceos/api run start:dev",
    "dev:web": "npm --workspace @aivoiceos/admin-web run dev",
    "db:push": "npm --workspace @aivoiceos/api run db:push",
    "db:migrate": "npm --workspace @aivoiceos/api run db:migrate",
    "db:seed": "npm --workspace @aivoiceos/api run db:seed",
    "lint": "turbo run lint",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "patch-package": "^8.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}
