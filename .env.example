# AI Voice OS — root env (development)
DATABASE_URL=postgresql://aivoiceos:aivoiceos_dev@127.0.0.1:5432/aivoiceos?schema=public

# API
API_PORT=4000
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Super-admin bootstrap (created by seed)
SUPERADMIN_EMAIL=admin@aivoiceos.local
SUPERADMIN_PASSWORD=Admin12345!
SUPERADMIN_ORG=AI Voice OS

# Admin web
NEXT_PUBLIC_API_URL=http://localhost:4000

# Voice Engine (ADR-0003) — provider-agnostic; default is free Edge Neural AZ TTS
# edge_neural | azure | openai | local_open  (elevenlabs disabled by policy)
VOICE_PROVIDER=edge_neural
VOICE_LLM_MODEL=gpt-4o-mini
# Cheap chat LLM for dialogue turns (TTS itself is free)
OPENAI_API_KEY=
