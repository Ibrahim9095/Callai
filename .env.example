# AI Voice OS — root env (development)
DATABASE_URL=postgresql://aivoiceos:aivoiceos_dev@127.0.0.1:5432/aivoiceos?schema=public

# API
API_PORT=4000
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Super-admin bootstrap (created by seed)
SUPERADMIN_EMAIL=admin@aivoiceos.local
SUPERADMIN_PASSWORD=Admin12345!
SUPERADMIN_ORG=AI Voice OS

# Admin web
NEXT_PUBLIC_API_URL=http://localhost:4000

# Voice Engine — ElevenLabs v3 Conversational (production default)
# Paste ELEVENLABS_API_KEY and restart API.
VOICE_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=hpp4J3VqNfWAUOO0d1Us
ELEVENLABS_VOICE_ID_MALE=iP95p4xoKVk53GoZ742B
ELEVENLABS_TTS_MODEL=eleven_v3_conversational
ELEVENLABS_LLM=gemini-2.5-flash
ELEVENLABS_SPEAK_MODEL=eleven_multilingual_v2
ELEVENLABS_TTS_SPEED=1.08
# Optional: JSON array of pronunciation dictionary locators
# ELEVENLABS_PRONUNCIATION_DICTS=[{"pronunciation_dictionary_id":"...","version_id":"..."}]

# Optional: OpenAI Realtime (VOICE_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_CHAT_MODEL=gpt-4o-mini
VOICE_LLM_MODEL=gpt-4o-mini
OPENAI_VOICE=marin
OPENAI_VOICE_FEMALE=marin
OPENAI_VOICE_MALE=cedar
