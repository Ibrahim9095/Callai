# AI Voice OS — root env (development)
DATABASE_URL=postgresql://aivoiceos:aivoiceos_dev@127.0.0.1:5432/aivoiceos?schema=public

# API
API_PORT=4000
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Super-admin bootstrap (created by seed)
SUPERADMIN_EMAIL=admin@aivoiceos.local
SUPERADMIN_PASSWORD=Admin12345!
SUPERADMIN_ORG=AI Voice OS

# Admin web
NEXT_PUBLIC_API_URL=http://localhost:4000

# Voice Engine — OpenAI (mandatory STT/TTS models)
# Only OPENAI_API_KEY is required — paste key and restart API.
VOICE_PROVIDER=openai
OPENAI_API_KEY=

# Mandatory models (do not use whisper / tts-1)
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Realtime low-latency live calls
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_CHAT_MODEL=gpt-4o-mini
VOICE_LLM_MODEL=gpt-4o-mini

# Voices
OPENAI_VOICE=marin
OPENAI_VOICE_FEMALE=marin
OPENAI_VOICE_MALE=cedar
OPENAI_TTS_SPEED=1.15

# VAD (call-center turn-taking + barge-in)
OPENAI_VAD_SILENCE_MS=400
OPENAI_VAD_THRESHOLD=0.5
OPENAI_VAD_PREFIX_MS=200
